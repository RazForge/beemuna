# ═══════════════════════════════════════════════════════════
# BE'EMUNA — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────
SECRET_KEY=                    # 64-byte random hex — generate with: python -c "import secrets; print(secrets.token_hex(64))"
DATABASE_URL=                  # PostgreSQL connection string
REDIS_URL=                     # Redis connection string

# ── AI Provider (BE'EMUNA AI Gateway) ─────────────────────
# The AI Gateway uses a 4-model fallback chain:
#   Primary → Reasoning → Fallback → Multimodal
# All responses display as "Beemuna AI" (no provider names)

AI_PROVIDER=                   # openai_compatible
AI_MODEL=                      # Primary model name
AI_BASE_URL=                   # Primary model API endpoint
AI_API_KEY=                    # Primary model API key

# Fallback models (optional — used if primary fails)
AI_REASONING_MODEL=            # Reasoning model name
AI_FALLBACK_MODEL=             # Fallback model name
AI_MULTIMODAL_MODEL=           # Multimodal model name
NVIDIA_API_KEY=                # API key for fallback models

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=           # https://your-api.up.railway.app/api/v1/auth/google/callback

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=           # https://your-api.up.railway.app/api/v1
NEXT_PUBLIC_APP_URL=           # https://your-app.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Email (SMTP) — Optional ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BE'EMUNA <noreply@beemuna.app>

# ── Billing (Stripe) — Optional ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# ── Storage ───────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400       # 25MB

# ── Notifications ─────────────────────────────────────────
DEFAULT_QUIET_HOURS_START=22:00
DEFAULT_QUIET_HOURS_END=07:00
DEFAULT_TIMEZONE=Africa/Addis_Ababa

# ── Auth ──────────────────────────────────────────────────
REGISTER_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Email Verification ───────────────────────────────────
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=48
