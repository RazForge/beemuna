# ---- Application ----
APP_NAME=BE'EMUNA
ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_HEX_64BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Database ----
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ---- Redis ----
REDIS_URL=rediss://default:[password]@[instance].upstash.io:6379

# ---- Frontend ----
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api/v1
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---- CORS ----
CORS_ORIGINS=["https://your-app.vercel.app"]

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api.up.railway.app/api/v1/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- AI Provider (NVIDIA Cloud) ----
AI_PROVIDER=openai_compatible
AI_MODEL=meta/llama-3.1-8b-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your-nvidia-api-key-here

# ---- Embeddings ----
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
OPENAI_API_KEY=

# ---- Storage ----
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_BYTES=26214400

# ---- Notifications ----
DEFAULT_QUIET_HOURS_START=22:00
DEFAULT_QUIET_HOURS_END=07:00
DEFAULT_TIMEZONE=UTC

# ---- Billing (Optional) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
